# HA Bridge Configuration

# Optional: LLM provider and model (defaults shown)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001

# Required (if LLM_PROVIDER=anthropic, the default): Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: OpenAI provider (set LLM_PROVIDER=openai to use)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Required: Home Assistant connection
HA_URL=https://192.168.88.14:8123
HA_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Required: Shodh Memory connection
SHODH_URL=http://localhost:3030
# SHODH_API_KEY is auto-generated by deploy.sh for Docker deployments
SHODH_API_KEY=your-shodh-api-key

# Optional: Server configuration
PORT=3100
LOG_LEVEL=info

# Optional: Home Assistant TLS
HA_SKIP_TLS_VERIFY=true

# Optional: Memory settings
MEMORY_TOKEN_LIMIT=1500

# Optional: Conversation history storage (memory = in-memory, sqlite = persistent)
# CONVERSATION_STORAGE=memory
# CONVERSATION_DB_PATH=/data/conversations.db

# Optional: Custom system prompt (AI personality / behavioral rules)
# CUSTOM_PROMPT=You are Ava, a friendly and slightly sarcastic smart home assistant.

# Optional: entity domains kept in the home layout that ships in every system
# prompt. On a large install area_entities() returns every entity, most of them
# config/diagnostic ones nobody asks a voice assistant about. Unset uses a
# sensible default (controllable domains + sensor/binary_sensor); "all" keeps
# everything; a comma-separated list overrides it.
# LAYOUT_DOMAINS=light,switch,cover,climate,media_player,sensor,binary_sensor

# Optional: build the home layout from the entities exposed to Assist
# (Settings -> Voice assistants -> Expose) instead of filtering by domain.
# This is what Home Assistant's own conversation agent does, and it is far
# smaller. Needs the websocket API; falls back to LAYOUT_DOMAINS when the list
# cannot be read or is empty. Set to false to always filter by domain.
# LAYOUT_FROM_EXPOSED=true
