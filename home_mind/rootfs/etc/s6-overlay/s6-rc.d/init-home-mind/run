#!/usr/bin/with-contenv bashio
# ==============================================================================
# Prepare persistent state under /data
#
# Option validation lives in the home-mind service instead: a failing oneshot
# only blocks its dependents, leaving the add-on up but idle, while a failing
# longrun reaches its finish script and halts the add-on with a visible error.
# ==============================================================================

# Shodh authenticates the server with a key that never leaves the container.
# It is generated once and kept so memories survive restarts and updates.
if ! bashio::fs.file_exists '/data/shodh_api_key'; then
    head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > /data/shodh_api_key
    chmod 600 /data/shodh_api_key
    bashio::log.info "Generated a new Shodh Memory API key"
fi

mkdir -p /data/shodh
